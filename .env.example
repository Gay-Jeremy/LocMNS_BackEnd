# Modele de configuration. Copier ce fichier en .env et renseigner les valeurs.
# Le .env n'est jamais versionne.

# Connexion de l'application a la base
# localhost quand l'application est lancee depuis l'IDE (hors reseau Docker).
# Dans un conteneur, la valeur est imposee par le compose : postgres.
DB_HOST=localhost
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=

# Initialisation du conteneur PostgreSQL
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# Securite
JWT_SECRET=

# Schema et jeu de donnees
DDL_AUTO=
SQL_FILE=init
SQL_INIT_MODE=always

# Origines autorisees, separees par des virgules
CORS_ALLOWED_ORIGINS=http://localhost:4200
